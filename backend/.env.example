# ── MongoDB (Atlas) — single datastore ───────────────────────────────
# Users, orders, FAQ (with embeddings), chat sessions, tickets, summaries.
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/ai-support-agent?retryWrites=true&w=majority

# ── LLM (Groq or Gemini) ─────────────────────────────────────────────
# LLM_PROVIDER = groq | google
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=xxxxxxxx
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=xxxxxxxx

# ── Embeddings (Gemini, 768 dims, stored as arrays in Mongo) ───────────────
EMBEDDINGS_MODEL=gemini-embedding-001

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=7d

# ── App ──────────────────────────────────────────────────────────────
PORT=3001
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000