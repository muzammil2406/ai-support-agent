# ── PostgreSQL (Neon) ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/ai-support-agent?sslmode=require

# ── MongoDB (Atlas) — chat transcripts/sessions ────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/ai-support-agent?retryWrites=true&w=majority

# ── Upstash Redis — session state + rate limiting ──────────────────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# ── BullMQ Redis (post-conversation background jobs) ───────────────
# BullMQ needs a SOCKET Redis connection (the REST url/token above cannot drive
# it). Use the Upstash TLS url from the console (starts with rediss://) or a
# local Redis.
BULLMQ_REDIS_URL=rediss://default:password@xxx.upstash.io:6379

# ── LLM (Groq or Gemini) ───────────────────────────────────────────
# LLM_PROVIDER = groq | google
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=xxxxxxxx
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=xxxxxxxx

# ── Embeddings (Gemini text-embedding-004 → 768 dims, matches pgvector column) ──
EMBEDDINGS_MODEL=text-embedding-004

# ── Auth ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=7d

# ── App ────────────────────────────────────────────────────────────
PORT=3001
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000
