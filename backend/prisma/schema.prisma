// Prisma schema — PostgreSQL (Neon) with pgvector extension.
// Run: npx prisma migrate dev
// The vector column below relies on the pgvector extension being enabled:
//   CREATE EXTENSION IF NOT EXISTS vector;
// (see prisma/pgvector.sql for the extension + ivfflat index)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identity ────────────────────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String // bcrypt hash — never store plaintext
  role      Role     @default(customer) // customer | support_agent | admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders  Order[]
  tickets Ticket[]

  @@map("users")
}

enum Role {
  customer
  support_agent
  admin
}

// ── Orders (seeded with fake data) ──────────────────────────────────────────
model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  status      OrderStatus
  total       Decimal  @db.Decimal(10, 2)
  itemCount   Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("orders")
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
  refunded
}

// ── FAQ knowledge base (embeddings stored in pgvector) ──────────────────────
// `Unsupported("vector(...)")` maps to the native pgvector column type.
// Dimension must match the embedding model used at seed time.
// text-embedding-004 (Gemini) → 768 dims.
model FaqEntry {
  id        String                        @id @default(cuid())
  question  String
  answer    String                        @db.Text
  category  String
  // This is the pgvector column. Queried directly with raw SQL
  // (SELECT ... ORDER BY embedding <=> $1 LIMIT 5) — never loaded fully into memory.
  embedding Unsupported("vector(768)")?

  @@index([category])
  @@index([question])
  @@map("faq_entries")
}

// ── Support tickets ─────────────────────────────────────────────────────────
// Created on human escalation; links back to the Mongo chat session via sessionId.
model Ticket {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  summary   String?    @db.Text
  status    TicketStatus @default(open) // open | in_progress | resolved | closed
  priority  Priority   @default(normal) // low | normal | high | urgent
  sessionId String? // Mongo chat-session id (secondary DB)
  escalatedAt DateTime? @default(now())
  resolvedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, status])
  @@map("tickets")
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum Priority {
  low
  normal
  high
  urgent
}
